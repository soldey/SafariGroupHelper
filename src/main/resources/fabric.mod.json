{
    "schemaVersion": 1,
    "id": "safarigrouphelper",
    "version": "${version}",
    "name": "Safari Group Helper",
    "icon": "assets/safarigrouphelper/icon.png",
    "description": "Tracks unique critters caught by your group in the Hypixel SkyBlock Critter Safari. Something broken? Send the log to soldey on Discord.",
    "authors": [
        "kmsold"
    ],
    "contact": {
        "homepage": "https://github.com/soldey/SafariGroupHelper",
        "sources": "https://github.com/soldey/SafariGroupHelper",
        "issues": "https://github.com/soldey/SafariGroupHelper/issues"
    },
    "license": "LGPL-3.0-or-later",
    "environment": "client",
    "entrypoints": {
        "client": [
            {
                "adapter": "kotlin",
                "value": "me.kmsold.safarigrouphelper.SafariGroupHelper"
            }
        ],
        "modmenu": [
            "me.kmsold.safarigrouphelper.compat.ModMenuIntegration"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabricLoader}",
        "fabric-api": "*",
        "fabric-language-kotlin": ">=${fabricKotlin}",
        "minecraft": "${minecraft}"
    },
    "recommends": {
        "hypixel-mod-api": "*"
    }
}
